[Unit]
Description=NTN UDP Server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ntnudp
Group=ntnudp
WorkingDirectory=/opt/ntn-udp-server
ExecStart=/usr/bin/python3 /opt/ntn-udp-server/main.py --host 0.0.0.0 --port 9000
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
